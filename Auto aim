-- LOGIKA VISIBILITY
local function isVisible(targetPart)
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    local result = workspace:Raycast(origin, direction, raycastParams)
    
    if result and result.Instance:IsDescendantOf(targetPart.Parent) then return true end
    return result == nil
end

-- MENCARI PEMAIN (STICKY LOCK + TARGET PRIORITY)
local function getNearestPlayer()
    local selectedPartName = targets[currentTargetIndex]
    
    -- 1V1 TARGET MANUAL
    if lock1v1Enabled and selectedTargetPlayer and selectedTargetPlayer.Character then
        local char = selectedTargetPlayer.Character
        if char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            local targetPart = char:FindFirstChild(selectedPartName) or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Head") or char.PrimaryPart
            if targetPart then
                if not wallCheckEnabled or isVisible(targetPart) then return targetPart end
            end
        end
    end

    if not autoAimEnabled then
        currentLockedCharacter = nil
        return nil 
    end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart or myChar:FindFirstChild("Head"))
    if not myRoot then return nil end

    -- SISTEM STICKY LOCK PADA AUTO AIM
    if currentLockedCharacter and currentLockedCharacter:FindFirstChild("Humanoid") and currentLockedCharacter.Humanoid.Health > 0 then
        local lockedPlayer = Players:GetPlayerFromCharacter(currentLockedCharacter)
        local isTeam = lockedPlayer and isTeammate(lockedPlayer)
        
        if not isTeam then
            local targetPart = currentLockedCharacter:FindFirstChild(selectedPartName) or currentLockedCharacter:FindFirstChild("Head") or currentLockedCharacter.PrimaryPart
            if targetPart then
                local distToPlayer = (targetPart.Position - myRoot.Position).Magnitude
                if distToPlayer <= maxDistance then
                    if not wallCheckEnabled or isVisible(targetPart) then
                        return targetPart -- Tahan Lock ke orang ini
                    end
                end
            end
        else
            currentLockedCharacter = nil 
        end
    end

    -- CARI MUSUH BARU BERDASARKAN PRIORITAS (CROSSHAIR vs DISTANCE)
    local nearestTarget = nil
    local shortestDistance = math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not isTeammate(player) then
            local char = player.Character
            if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                local targetPart = char:FindFirstChild(selectedPartName) or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Head") or char.PrimaryPart
                
                if targetPart then
                    local distToPlayer = (targetPart.Position - myRoot.Position).Magnitude
                    
                    if distToPlayer <= maxDistance then
                        if not wallCheckEnabled or isVisible(targetPart) then
                            local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                            
                            if onScreen then
                                if targetPriority == "Crosshair" then
                                    local mousePos = Vector2.new(screenPoint.X, screenPoint.Y)
                                    local distanceFromCenter = (mousePos - screenCenter).Magnitude
                                    if distanceFromCenter < shortestDistance then
                                        shortestDistance = distanceFromCenter
                                        nearestTarget = targetPart
                                    end
                                elseif targetPriority == "Distance" then
                                    -- Prioritas: Jarak Paling Dekat Dengan Karakter Kita
                                    if distToPlayer < shortestDistance then
                                        shortestDistance = distToPlayer
                                        nearestTarget = targetPart
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    if nearestTarget then
        currentLockedCharacter = nearestTarget.Parent
    else
        currentLockedCharacter = nil
    end
    
    return nearestTarget
end

-- // LOOP UTAMA: AIMBOT & 3D ANIMATED ESP //
RunService.RenderStepped:Connect(function()
    local shouldAim = false
    local targetPart = nil
    
    if lock1v1Enabled and selectedTargetPlayer then
        shouldAim = true
    elseif autoAimEnabled then
        if aimMode == "Always" then
            shouldAim = true
        elseif aimMode == "OnAttack" and isAttacking then
            shouldAim = true
        end
    end
    
    if not shouldAim then
        currentLockedCharacter = nil
    end
    
    if autoAimEnabled or lock1v1Enabled then
        targetPart = getNearestPlayer()
    end
    
    -- LOGIKA GARIS TRACER & ANIMASI IKON (SMART ESP)
    if targetEspEnabled and targetPart and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
        local myHead = LocalPlayer.Character.Head
        
        Att0.Parent = workspace.Terrain
        Att1.Parent = workspace.Terrain
        ESPBeam.Parent = workspace.Terrain
        
        Att0.WorldPosition = myHead.Position
        Att1.WorldPosition = targetPart.Position
        
        TargetIconGui.Adornee = targetPart
        TargetIconGui.Enabled = true
        
        local timeTick = tick()
        TargetIconImage.Rotation = (timeTick * 100) % 360 
        local pulseSize = 25 + (math.sin(timeTick * 6) * 5)
        TargetIconGui.Size = UDim2.new(0, pulseSize, 0, pulseSize)
        
        if isVisible(targetPart) then
            ESPBeam.Color = ColorSequence.new(Color3.fromRGB(255, 50, 50)) 
            TargetIconImage.ImageColor3 = Color3.fromRGB(255, 50, 50)
        else
            ESPBeam.Color = ColorSequence.new(Color3.fromRGB(50, 255, 50)) 
            TargetIconImage.ImageColor3 = Color3.fromRGB(50, 255, 50)
        end
    else
        Att0.Parent = nil
        Att1.Parent = nil
        ESPBeam.Parent = nil
        TargetIconGui.Enabled = false
    end
    
    -- Logika Kamera 
    local myChar = LocalPlayer.Character
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart or myChar:FindFirstChild("Head"))
    
    if shouldAim and targetPart and myRoot then
        local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
        local speed = lock1v1Enabled and 1.0 or smoothnessFactor
        
        if speed >= 1.0 then
            Camera.CFrame = targetCFrame 
        else
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, speed)
        end
    end
end)
