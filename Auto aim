-- AUTO REFRESH PLAYER LIST
function updatePlayerList()
    for _, child in pairs(PlayerScrollFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local searchText = string.lower(PlayerSearchBox.Text)
    local count = 0

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local playerName = player.Name
            local displayName = player.DisplayName
            
            if searchText == "" or string.find(string.lower(playerName), searchText) or string.find(string.lower(displayName), searchText) then
                if not isTeammate(player) then
                    count = count + 1
                    
                    local pBtn = Instance.new("TextButton", PlayerScrollFrame)
                    pBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
                    pBtn.Size = UDim2.new(1, 0, 0, 20)
                    pBtn.Font = Enum.Font.Gotham
                    pBtn.Text = "  " .. displayName .. " (@" .. playerName .. ")"
                    pBtn.TextColor3 = (selectedTargetPlayer == player) and Color3.fromRGB(95, 255, 135) or Color3.fromRGB(220, 220, 240)
                    pBtn.TextSize = 10
                    pBtn.TextXAlignment = Enum.TextXAlignment.Left
                    pBtn.BorderSizePixel = 0
                    Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 3)
                    
                    pBtn.MouseButton1Click:Connect(function()
                        if selectedTargetPlayer == player then
                            selectedTargetPlayer = nil
                            lock1v1Enabled = false
                            LockTargetToggle.Text = "1v1 Lock: OFF"
                            LockTargetToggle.TextColor3 = Color3.fromRGB(255, 95, 95)
                        else
                            selectedTargetPlayer = player
                        end
                        updatePlayerList()
                    end)
                end
            end
        end
    end
    PlayerScrollFrame.CanvasSize = UDim2.new(0, 0, 0, count * 22)
end

